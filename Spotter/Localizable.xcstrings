    "A clean rep you can repeat is stronger than a heavy one you survive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التكرار النظيف الذي تستطيع إعادته أقوى من التكرار الثقيل الذي بالكاد تنجو منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine saubere Wiederholung, die du wiederholen kannst, ist stärker als eine schwere, die du nur überstehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una repetición limpia que puedes repetir es más fuerte que una pesada que apenas sobrevives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une répétition propre que tu peux refaire est plus forte qu’une lourde que tu subis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो रेप आप दोहरा सकते हैं, वह उस भारी रेप से मजबूत है जिसे आप मुश्किल से झेलते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返せるきれいな1回は、かろうじて耐える重い1回より強い。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma repetição limpa que você consegue repetir é mais forte do que uma pesada que você só aguenta."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو ریپ آپ دہرا سکتے ہیں وہ اس بھاری ریپ سے مضبوط ہے جسے آپ بمشکل جھیلتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能重复的干净次数，比勉强撑住的大重量更强。"
          }
        }
      }
    },
    "A healthy weight for your height is %@. You are %@ %@ above it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوزن الصحي لطولك هو %1$@. أنت أعلى منه بـ %2$@ %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gesundes Gewicht für deine Größe ist %1$@. Du liegst %2$@ %3$@ darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A healthy weight for your height is %1$@. You are %2$@ %3$@ above it."
