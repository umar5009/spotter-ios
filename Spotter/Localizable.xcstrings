    "Range you can control is range you get to keep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدى الذي تتحكم به هو المدى الذي تحتفظ به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Radius, den du kontrollierst, ist der, den du behältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rango que controlas es el rango que conservas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplitude que tu contrôles est celle que tu gardes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस रेंज को आप नियंत्रित करते हैं, वही रेंज आपके पास रहती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールできる可動域が、残る可動域です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A amplitude que você controla é a amplitude que você fica."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جس رینج پر آپ قابو رکھتے ہیں، وہی رینج آپ کے پاس رہتی ہے۔"
          }
        },
        "zh-Hans" : {
