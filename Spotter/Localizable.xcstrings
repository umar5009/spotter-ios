    },
    "A second full-body day so Monday isn't the only hard one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوم ثانٍ لكامل الجسم حتى لا يكون الاثنين هو اليوم الصعب الوحيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zweiter Ganzkörper-Tag, damit der Montag nicht der einzige schwere Tag ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un segundo día de cuerpo completo para que el lunes no sea el único duro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un deuxième jour corps entier pour que le lundi ne soit pas le seul jour dur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक और पूरा-शरीर वाला दिन, ताकि सोमवार ही अकेला कठिन दिन न रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月曜だけがきつい日にならないよう、全身の日をもう1日。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um segundo dia de corpo inteiro para a segunda não ser o único dia pesado."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک اور پورے جسم کا دن، تاکہ پیر ہی اکیلا سخت دن نہ رہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
