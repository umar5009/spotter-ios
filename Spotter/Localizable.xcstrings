    "Feet shoulder-width apart, toes turned out slightly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القدمان بعرض الكتفين، وأصابع القدم للخارج قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füße schulterbreit, Zehen leicht nach außen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pies al ancho de hombros, puntas un poco hacia fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieds à largeur d’épaules, pointes légèrement ouvertes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैर कंधे की चौड़ाई पर, अँगूठे थोड़े बाहर।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足は肩幅、つま先は少し外へ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pés na largura dos ombros, pontas levemente para fora."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
