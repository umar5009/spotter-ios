    "Keep a straight line from head to heels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على خط مستقيم من الرأس إلى الكعبين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt eine gerade Linie vom Kopf zu den Fersen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén una línea recta de la cabeza a los talones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde une ligne droite de la tête aux talons."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर से एड़ी तक एक सीधी रेखा रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭からかかとまで一直線を保つ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha uma linha reta da cabeça aos calcanhares."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سر سے ایڑی تک ایک سیدھی لکیر رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头到脚跟保持一条直线。"
          }
        }
      }
    },
    "Keep elbows angled roughly 45° from your body." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ المرفقين بزاوية 45° تقريبًا عن الجسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt die Ellbogen etwa 45° vom Körper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los codos a unos 45° del cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde les coudes à environ 45° du corps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहनी शरीर से लगभग 45° पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひじは体からおよそ45°。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os cotovelos a cerca de 45° do corpo."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کہنیاں جسم سے تقریباً 45° پر رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手肘与身体大约成 45°。"
          }
        }
      }
    },
