    "Too hard? Do them from your knees. Spotter still checks your body line." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صعب جدًا؟ أدّها من الركبتين. Spotter ما زال يفحص خط جسمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu schwer? Mach sie auf den Knien. Spotter prüft weiter die Körperlinie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Muy difícil? Hazlas de rodillas. Spotter sigue mirando la línea del cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop dur ? Fais-les sur les genoux. Spotter vérifie toujours la ligne du corps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत कठिन? घुटनों के बल करें। Spotter फिर भी शरीर की रेखा देखता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きつすぎる？ ひざをついて。Spotterは体のラインを見続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difícil demais? Faça de joelhos. O Spotter continua olhando a linha do corpo."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہت مشکل؟ گھٹنوں کے بل کریں۔ Spotter پھر بھی جسم کی لکیر دیکھتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太难？可以跪着做。Spotter 仍会检查身体线条。"
          }
        }
      }
    },
