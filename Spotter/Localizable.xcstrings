          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un entrenador personal que mira cada repetición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coach qui regarde chaque répétition."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ट्रेनर जो हर रेप देखता है।"
