    "Each choice repeats every week. Tap a day to open it on the home screen." : {

    },
    "Each exercise you finish is kept here with the reps, load and form score." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل تمرين تنهيه يُحفظ هنا مع التكرارات والحمل والأداء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Übung, die du beendest, bleibt hier mit Wiederholungen, Last und Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ejercicio que terminas se guarda aquí con repeticiones, carga y técnica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque exercice terminé est gardé ici avec les répétitions, la charge et la technique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो व्यायाम आप पूरा करते हैं, वह रेप, भार और फॉर्म के साथ यहाँ रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終えた種目は、回数、負荷、フォームとともにここに残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada exercício que você termina fica aqui com repetições, carga e técnica."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو مشق آپ مکمل کرتے ہیں وہ ریپس، بوجھ اور فارم کے ساتھ یہاں رہتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你完成的每个动作都会留在这里，包括次数、负重和动作质量。"
          }
        }
      }
    },
