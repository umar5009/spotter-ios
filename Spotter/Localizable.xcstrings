    "If the form breaks, the set is over. That's discipline, not quitting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا انكسر الأداء انتهت المجموعة. هذا انضباط وليس استسلامًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Form bricht, ist der Satz vorbei. Das ist Disziplin, kein Aufgeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la técnica se rompe, la serie se acaba. Eso es disciplina, no rendirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la technique casse, la série s’arrête. C’est de la discipline, pas un abandon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फॉर्म टूटे तो सेट खत्म। यह अनुशासन है, हार नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォームが崩れたらセットは終わり。それは規律で、諦めではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a técnica quebra, a série acaba. Isso é disciplina, não desistência."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فارم ٹوٹے تو سیٹ ختم۔ یہ نظم ہے، ہار نہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动作变形，这组就结束。这是纪律，不是放弃。"
          }
        }
      }
    },
