    "Log the weigh-in and get on with the day. One reading is not a verdict." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الوزن وأكمل يومك. قراءة واحدة ليست حكمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag das Gewicht ein und mach mit dem Tag weiter. Eine Messung ist kein Urteil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota el peso y sigue con el día. Una lectura no es un veredicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note le poids et continue ta journée. Une mesure n’est pas un verdict."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न लिखें और दिन आगे बढ़ाएँ। एक रीडिंग फ़ैसला नहीं है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重を記録して、その日を続ける。1回の数値は判決ではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote o peso e siga o dia. Uma medida não é um veredito."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وزن لکھیں اور دن آگے بڑھائیں۔ ایک ریڈنگ فیصلہ نہیں۔"
