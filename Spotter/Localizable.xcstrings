    "Brace your core and sit your hips back and down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شد جذعك وأنزل وركك للخلف وللأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spann den Rumpf an und schieb die Hüfte nach hinten und unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el abdomen y lleva las caderas atrás y abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaine le ventre et envoie les hanches en arrière et vers le bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोर कसें और कूल्हे पीछे और नीचे ले जाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体幹を固めて、腰を後ろに下ろす。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o abdômen e leve o quadril para trás e para baixo."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کور کسیں اور کولہے پیچھے اور نیچے لے جائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收紧核心，髋向后向下坐。"
          }
        }
      }
    },
    "Brace your core and squeeze your glutes. Ribs stay down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شد جذعك واقبض الأرداف. الأضلاع تبقى للأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spann den Rumpf an und drück das Gesäß zusammen. Die Rippen bleiben unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el abdomen y aprieta los glúteos. Las costillas quietas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaine le ventre et serre les fessiers. Les côtes restent basses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोर कसें और ग्लूट्स भींचें। पसलियाँ नीचे रहें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体幹を固め、お尻を締める。肋骨は下げたまま。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o abdômen e contraia os glúteos. As costelas ficam baixas."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کور کسیں اور گلوٹس بھیچیں۔ پسلیاں نیچے رہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收紧核心并夹紧臀部。肋骨保持下沉。"
          }
        }
      }
    },
    "Brace, then move. The weight only goes up if the position holds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدّ ثم تحرّك. الوزن يرتفع فقط إذا ثبت الوضع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spann an, dann beweg dich. Das Gewicht steigt nur, wenn die Position hält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa, luego muévete. El peso solo sube si la posición se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaine, puis bouge. La charge ne monte que si la position tient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले कसें, फिर हिलें। वज़न तभी बढ़ता है जब स्थिति टिकी रहे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固めてから動く。ポジションが保てて初めて重量は上がります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative, depois mova. O peso só sobe se a posição se mantiver."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے کسیں، پھر ہلیں۔ وزن تبھی بڑھتا ہے جب پوزیشن ٹکی رہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先绷紧，再移动。位置稳住，重量才能往上加。"
          }
        }
      }
    },
