    "Body weight, the load on a lift, and your height all follow these units. BMI stays the same either way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وزن الجسم وحمل التمرين وطولك تتبع هذه الوحدات. مؤشر كتلة الجسم لا يتغير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körpergewicht, Hantelgewicht und Größe folgen diesen Einheiten. Der BMI bleibt gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El peso corporal, la carga de un ejercicio y tu estatura siguen estas unidades. El IMC no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le poids du corps, la charge d’un exercice et ta taille suivent ces unités. L’IMC ne change pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरीर का वज़न, व्यायाम का भार और ऊँचाई इन्हीं इकाइयों में हैं। BMI वही रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重、挙上重量、身長はすべてこの単位に従います。BMIは同じです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O peso do corpo, a carga de um exercício e a sua altura seguem estas unidades. O IMC não muda."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جسم کا وزن، مشق کا بوجھ اور قد انہی اکائیوں میں ہیں۔ BMI وہی رہتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重、负重和身高都按这些单位显示。BMI 不受影响。"
          }
        }
      }
    },
