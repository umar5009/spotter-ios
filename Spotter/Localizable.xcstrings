    "Chest stays toward the floor" : {

    },
    "Choose kilograms or pounds, and centimetres or feet and inches. BMI uses the same numbers either way. Healthy for most adults is 18.5–24.9." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الكيلوغرام أو الرطل، والسنتيمتر أو القدم والبوصة. مؤشر كتلة الجسم يستخدم الأرقام نفسها. النطاق الصحي لمعظم البالغين هو 18.5–24.9."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Kilogramm oder Pfund, und Zentimeter oder Fuß und Zoll. Der BMI nutzt dieselben Zahlen. Gesund für die meisten Erwachsenen ist 18,5–24,9."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige kilogramos o libras, y centímetros o pies y pulgadas. El IMC usa los mismos números. Lo saludable para la mayoría de adultos es 18,5–24,9."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis les kilogrammes ou les livres, et les centimètres ou les pieds et pouces. L’IMC utilise les mêmes nombres. La zone saine pour la plupart des adultes est 18,5–24,9."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किलोग्राम या पाउंड चुनें, और सेंटीमीटर या फीट और इंच। BMI वही संख्याएँ इस्तेमाल करता है। अधिकतर वयस्कों के लिए स्वस्थ सीमा 18.5–24.9 है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キログラムかポンド、センチメートルかフィートとインチを選びます。BMIは同じ数字を使います。多くの成人の健康範囲は18.5〜24.9です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quilogramas ou libras, e centímetros ou pés e polegadas. O IMC usa os mesmos números. Saudável para a maioria dos adultos é 18,5–24,9."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلوگرام یا پاؤنڈ چنیں، اور سینٹی میٹر یا فٹ اور انچ۔ BMI وہی اعداد استعمال کرتا ہے۔ زیادہ تر بالغوں کے لیے صحت مند حد 18.5–24.9 ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择千克或磅，以及厘米或英尺和英寸。BMI 用的是同一组数字。大多数成年人的健康范围是 18.5–24.9。"
          }
        }
      }
    },
