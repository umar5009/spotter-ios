    "Missing once is a date on a calendar. Missing twice is a story you start telling." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الغياب مرة تاريخ في التقويم. الغياب مرتين قصة تبدأ في روايتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal fehlen ist ein Datum im Kalender. Zweimal fehlen ist eine Geschichte, die du dir erzählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltar una vez es una fecha en el calendario. Faltar dos veces es una historia que empiezas a contarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manquer une fois, c’est une date sur le calendrier. Manquer deux fois, c’est une histoire que tu commences à te raconter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार चूकना कैलेंडर की तारीख है। दो बार चूकना वह कहानी है जो आप खुद को सुनाना शुरू करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回休むのはカレンダーの日付。2回休むのは、自分に語り始める物語です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltar uma vez é uma data no calendário. Faltar duas vezes é uma história que você começa a contar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک بار چھوٹنا کیلنڈر کی تاریخ ہے۔ دو بار چھوٹنا وہ کہانی ہے جو آپ خود کو سنانا شروع کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错过一次是日历上的一天。错过两次，就是你开始讲给自己的故事。"
          }
        }
      }
    },
