    "Times your hold only while your body is in position." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الثبات فقط حين يكون جسمك في الوضع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt die Haltezeit nur, solange dein Körper in Position ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronometra el aguante solo mientras el cuerpo está en posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronomètre le maintien seulement tant que ton corps est en position."
