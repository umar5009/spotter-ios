    "Pose detection runs entirely on your iPhone. Video is never recorded or uploaded." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كشف وضع الجسم يعمل كله على iPhone. لا يُسجَّل الفيديو ولا يُرفع أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Posenerkennung läuft ganz auf deinem iPhone. Video wird nie aufgenommen oder hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La detección de la postura ocurre por completo en tu iPhone. El vídeo nunca se graba ni se sube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection de la posture se fait entièrement sur ton iPhone. La vidéo n’est jamais enregistrée ni envoyée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोज़ पहचान पूरी तरह आपके iPhone पर चलती है। वीडियो कभी रिकॉर्ड या अपलोड नहीं होता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿勢の検出はすべてiPhone上で動きます。動画は録画もアップロードもされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A detecção da postura roda toda no seu iPhone. O vídeo nunca é gravado nem enviado."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوز کی پہچان پوری طرح آپ کے iPhone پر چلتی ہے۔ ویڈیو کبھی ریکارڈ یا اپ لوڈ نہیں ہوتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿势识别完全在你的 iPhone 上运行。视频不会被录制或上传。"
          }
        }
      }
    },
