    "A smaller deficit you can keep beats a perfect diet you quit on Thursday." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عجز صغير تستطيع الاستمرار عليه يتفوق على حمية مثالية تتركها يوم الخميس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Defizit, das du hältst, schlägt eine perfekte Diät, die du donnerstags abbrichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un déficit pequeño que puedes mantener gana a una dieta perfecta que dejas el jueves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit déficit que tu tiens bat un régime parfait que tu quittes jeudi."
