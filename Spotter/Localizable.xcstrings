    "Show up like someone is counting. The streak is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احضر كأن أحدًا يعدّ. السلسلة تعدّ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm, als würde jemand zählen. Die Serie tut es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece como si alguien estuviera contando. La racha lo está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viens comme si quelqu’un comptait. La série compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसे आएँ जैसे कोई गिन रहा हो। लय गिन रही है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かが数えているように来る。連続記録が数えています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apareça como se alguém estivesse contando. A sequência está."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایسے آئیں جیسے کوئی گن رہا ہو۔ لگاتار گن رہی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像有人在计数一样出现。连续记录就是那个计数的人。"
          }
        }
      }
    },
    "Show up sore and do the work you can do well." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احضر وأنت متعب واعمل جيدًا ما تستطيع عمله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm mit Muskelkater und mach die Arbeit gut, die du kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llega con agujetas y haz bien el trabajo que puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viens courbaturé et fais bien le travail que tu peux faire."
