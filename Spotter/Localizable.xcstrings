        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाथ कंधों से थोड़े चौड़े, शरीर एक सीधी रेखा में।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手は肩より少し広く、体は一直線。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mãos um pouco mais abertas que os ombros, corpo em uma linha reta."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہاتھ کندھوں سے تھوڑے چوڑے، جسم ایک سیدھی لکیر میں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双手略宽于肩膀，身体成一条直线。"
          }
        }
      }
