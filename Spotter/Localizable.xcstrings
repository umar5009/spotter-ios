    "Train hard enough to sweat. Eat enough to come back tomorrow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب بما يكفي لتتعرّق. وكُل بما يكفي لتعود غدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainier hart genug zum Schwitzen. Iss genug, um morgen wiederzukommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrena lo bastante para sudar. Come lo bastante para volver mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transpire à l’entraînement. Mange assez pour revenir demain."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतना ट्रेन करें कि पसीना आए। इतना खाएँ कि कल लौट सकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汗をかくほどやる。明日戻れるだけ食べる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treine o bastante para suar. Coma o bastante para voltar amanhã."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتنا ٹرین کریں کہ پسینہ آئے۔ اتنا کھائیں کہ کل واپس آ سکیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练到出汗。吃够，好让你明天还能来。"
          }
        }
      }
    },
