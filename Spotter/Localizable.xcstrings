          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひざを少しゆるめて、腰をまっすぐ後ろへ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrouxe um pouco os joelhos e leve o quadril reto para trás."
