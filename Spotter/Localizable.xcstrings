    "Finish your first coached workout to see your form score trend, personal bests and the one fix that will improve you most." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ أول تمرين مع المدرب لترى اتجاه الأداء وأرقامك وأهم تصحيح سيطوّرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende dein erstes begleitetes Training, um den Formtrend, Bestleistungen und die eine Korrektur zu sehen, die dich am meisten verbessert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina tu primer entrenamiento guiado para ver la tendencia de técnica, tus marcas y el ajuste que más te va a mejorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine ta première séance guidée pour voir la tendance de technique, tes records et la correction qui t’aidera le plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला कोच वाला वर्कआउट पूरा करें, तब फॉर्म का रुझान, आपके रिकॉर्ड और वह सुधार दिखेगा जो आपको सबसे अधिक आगे ले जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のコーチ付きワークアウトを終えると、フォームの傾向、自己ベスト、いちばん効く修正が見えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine o primeiro treino guiado para ver a tendência da técnica, os recordes e o ajuste que mais vai te melhorar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلا کوچ والا ورک آؤٹ مکمل کریں، تب فارم کا رجحان، آپ کے ریکارڈ اور وہ اصلاح نظر آئے گی جو آپ کو سب سے زیادہ آگے لے جائے گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成第一次有教练的训练，才能看到动作趋势、个人最佳，以及最能帮到你的那一项纠正。"
          }
        }
      }
    },
