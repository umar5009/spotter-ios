    "Hinge a little further. Feel the stretch in your hamstrings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انحنِ أكثر قليلًا. اشعر بالتمدد في أوتار الركبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beug dich etwas weiter. Spür die Dehnung in den Beinbeugern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisagra un poco más. Nota el estiramiento en los isquiotibiales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penche-toi un peu plus. Sens l’étirement dans les ischio-jambiers."
