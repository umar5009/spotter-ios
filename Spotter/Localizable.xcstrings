        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تھکے ہوئے آئیں اور جو کام اچھا کر سکتے ہیں اسے اچھا کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
