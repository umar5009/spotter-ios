    "Keep the reps honest. Sloppy volume doesn't move the trend." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل التكرارات صادقة. الحجم المهمل لا يحرّك الاتجاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ehrliche Wiederholungen. Schlampiges Volumen bewegt den Trend nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz las repeticiones de verdad. El volumen descuidado no mueve la tendencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais des répétitions honnêtes. Le volume bâclé ne fait pas bouger la tendance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेप ईमानदारी से करें। लापरवाह मात्रा रुझान नहीं हिलाती।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回数は正直に。雑な量では傾向は動きません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça repetições honestas. Volume malfeito não move a tendência."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ریپس ایمانداری سے کریں۔ لاپرواہ مقدار رجحان نہیں ہلاتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次数要做实。马虎的量不会推动趋势。"
          }
        }
      }
    },
