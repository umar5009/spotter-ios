          }
        }
      }
    },
    "A personal trainer that watches every rep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدرب شخصي يراقب كل تكرار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
