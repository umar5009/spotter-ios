    "A heavy lower pattern and an overhead press." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمط ثقيل للجزء السفلي مع ضغط فوق الرأس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein schweres Muster für die Beine und ein Drücken über Kopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un patrón pesado de tren inferior y un press por encima de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mouvement lourd du bas du corps et un développé au-dessus de la tête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भारी निचले शरीर का पैटर्न और एक ओवरहेड प्रेस।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重めの下半身パターンと、オーバーヘッドプレス。"
