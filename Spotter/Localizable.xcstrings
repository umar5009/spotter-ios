            "state" : "translated",
            "value" : "Hände etwas breiter als die Schultern, Körper in einer geraden Linie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manos un poco más abiertas que los hombros, cuerpo en una línea recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains un peu plus larges que les épaules, corps sur une ligne droite."
