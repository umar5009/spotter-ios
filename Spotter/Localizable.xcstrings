    "Breathe out as you reach the hard part. Don't hold the air hostage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخرج النفس عند الجزء الصعب. لا تحبس الهواء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme aus, wenn es schwer wird. Halt die Luft nicht fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta el aire al llegar a la parte difícil. No lo retengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souffle en arrivant dans la partie difficile. Ne retiens pas l’air."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कठिन हिस्से पर साँस छोड़ें। साँस रोककर न रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きついところで息を吐く。息を止めない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte o ar na parte difícil. Não prenda a respiração."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشکل حصے پر سانس چھوڑیں۔ سانس روک کر نہ رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到最难的地方时呼气。不要憋气。"
          }
        }
      }
    },
    "Breathe steadily. Spotter only counts time held with good form." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنفّس بهدوء. Spotter يحسب الوقت فقط حين يكون الأداء جيدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme ruhig. Spotter zählt nur die Zeit mit guter Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con calma. Spotter solo cuenta el tiempo con buena técnica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire régulièrement. Spotter ne compte que le temps tenu avec une bonne technique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शांत साँस लें। Spotter केवल अच्छा फॉर्म रहने का समय गिनता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち着いて呼吸する。Spotterはフォームが良い時間だけ数えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire com calma. O Spotter só conta o tempo com boa técnica."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرسکون سانس لیں۔ Spotter صرف اچھا فارم رہنے کا وقت گنتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平稳呼吸。Spotter 只计算动作到位的时间。"
          }
        }
      }
    },
