        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा और झुकें। हैमस्ट्रिंग में खिंचाव महसूस करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう少し倒す。ハムストリングの伸びを感じる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
