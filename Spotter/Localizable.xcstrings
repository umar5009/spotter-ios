    "Bodyweight at home, weights at the gym, or both." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وزن الجسم في المنزل، والأوزان في النادي، أو الاثنان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körpergewicht zu Hause, Gewichte im Studio, oder beides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso corporal en casa, pesas en el gimnasio, o ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poids du corps à la maison, charges à la salle, ou les deux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घर पर शरीर का वज़न, जिम में वज़न, या दोनों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家では自重、ジムではウェイト、または両方。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso corporal em casa, pesos na academia, ou os dois."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھر پر جسم کا وزن، جم میں وزن، یا دونوں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家做自重，在健身房用器械，或者两者都有。"
          }
        }
      }
    },
