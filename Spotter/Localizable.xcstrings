        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थके हुए आएँ और जो काम अच्छा कर सकते हैं, उसे अच्छा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
