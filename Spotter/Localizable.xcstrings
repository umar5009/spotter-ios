    "Five pictures is the limit for a 10-second video." : {

    },
    "Flags rushed lowering. Slow eccentrics build more muscle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّهك إذا كان النزول سريعًا. النزول البطيء يبني عضلًا أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet zu schnelles Absenken. Langsam senken baut mehr Muskel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa si bajas demasiado rápido. Bajar despacio construye más músculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale une descente trop rapide. Descendre lentement construit plus de muscle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत तेज़ नीचे लाने पर चेतावनी देता है। धीरे नीचे लाने से अधिक मांसपेशी बनती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下ろすのが速すぎると知らせます。ゆっくり下ろすほど筋肉は増えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa se a descida for rápida demais. Descer devagar constrói mais músculo."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہت تیزی سے نیچے لانے پر خبردار کرتا ہے۔ آہستہ نیچے لانے سے زیادہ پٹھا بنتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降太快时会提醒。慢速离心能长更多肌肉。"
          }
        }
      }
    },
