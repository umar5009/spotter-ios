          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو چھوٹا فرق آپ رکھ سکتے ہیں وہ اس کامل غذا سے بہتر ہے جسے آپ جمعرات چھوڑ دیتے ہیں۔"
