          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não persiga um número que piore a próxima sessão."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایسا عدد نہ پکڑیں جو اگلا سیشن خراب کر دے۔"
