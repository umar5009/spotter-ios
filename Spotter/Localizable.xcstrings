    "You don't have to feel motivated. You have to do the next set." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لست مضطرًا أن تشعر بالحماسة. عليك أن تؤدي المجموعة التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst dich nicht motiviert fühlen. Du musst den nächsten Satz machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que sentirte motivado. Tienes que hacer la siguiente serie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n’as pas besoin d’être motivé. Tu dois faire la série suivante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको प्रेरित महसूस करने की ज़रूरत नहीं। अगला सेट करना है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やる気を感じなくていい。次のセットをやればいい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não precisa se sentir motivado. Precisa fazer a próxima série."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو متحرک محسوس کرنے کی ضرورت نہیں۔ اگلا سیٹ کرنا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不必觉得有动力。你要做的是下一组。"
          }
        }
      }
    },
    "You don't need a perfect week. You need today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
