    "Same effort, ordinary day. That's how a habit gets boring enough to last." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجهد نفسه في يوم عادي. هكذا تصبح العادة مألوفة بما يكفي لتبقى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Einsatz, gewöhnlicher Tag. So wird eine Gewohnheit langweilig genug, um zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo esfuerzo, un día normal. Así un hábito se vuelve lo bastante aburrido para durar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même effort, jour ordinaire. C’est comme ça qu’une habitude devient assez simple pour durer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही मेहनत, साधारण दिन। आदत ऐसे ही इतनी साधारण बनती है कि टिक जाए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ努力、普通の日。習慣はそうして続くほど退屈になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mesmo esforço, um dia comum. É assim que um hábito fica simples o bastante para durar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی محنت، عام دن۔ عادت یوں ہی اتنی عام بنتی ہے کہ قائم رہ جائے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同样的努力，平常的一天。习惯就是这样变得普通，然后留下来。"
          }
        }
      }
    },
