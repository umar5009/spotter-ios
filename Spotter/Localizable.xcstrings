    "Spotter shapes your plan and coaching around it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبني Spotter خطتك والتدريب حول ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter baut deinen Plan und das Coaching darum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter arma tu plan y el entrenamiento alrededor de eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter construit ton plan et le coaching autour de ça."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter इसी के आसपास आपकी योजना और कोचिंग बनाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotterはそれをもとにプランとコーチングを作ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotter monta o seu plano e o treino em torno disso."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter اسی کے گرد آپ کا پلان اور کوچنگ بناتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter 会围绕它来安排计划和指导。"
          }
        }
      }
    },
    "Spotter speaks rep counts and form corrections and lowers your music while it talks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطق Spotter عدد التكرارات وتصحيحات الأداء ويخفض الموسيقى أثناء الكلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter sagt Wiederholungen und Formkorrekturen und senkt deine Musik, während er spricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter dice las repeticiones y las correcciones, y baja la música mientras habla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter annonce les répétitions et les corrections, et baisse ta musique pendant qu’il parle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter रेप और फॉर्म सुधार बोलता है और बोलते समय संगीत धीमा कर देता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotterは回数とフォームの修正を話し、話している間は音楽を下げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotter fala as repetições e as correções e abaixa a música enquanto fala."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter ریپس اور فارم کی اصلاح بولتا ہے اور بولتے وقت موسیقی ہلکی کر دیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter 会说出次数和动作纠正，并在说话时降低你的音乐。"
          }
        }
      }
    },
    "Spotter tracks 15 points on your body in real time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتتبع Spotter 15 نقطة على جسمك في الوقت الحقيقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter verfolgt 15 Punkte an deinem Körper in Echtzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter sigue 15 puntos de tu cuerpo en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter suit 15 points de ton corps en temps réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter आपके शरीर के 15 बिंदु रीयल टाइम में ट्रैक करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotterは体の15点をリアルタイムで追います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotter acompanha 15 pontos do seu corpo em tempo real."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter آپ کے جسم کے 15 نقطے حقیقی وقت میں ٹریک کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter 实时追踪你身上的 15 个点。"
          }
        }
      }
    },
    "Spotter watches your form through the camera. Everything is processed on your iPhone. No video is recorded or uploaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراقب Spotter أداءك عبر الكاميرا. كل المعالجة تتم على iPhone. لا يُسجَّل فيديو ولا يُرفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter sieht deine Form über die Kamera. Alles wird auf deinem iPhone verarbeitet. Es wird kein Video aufgenommen oder hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter mira tu técnica con la cámara. Todo se procesa en tu iPhone. No se graba ni se sube ningún vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter regarde ta technique avec la caméra. Tout est traité sur ton iPhone. Aucune vidéo n’est enregistrée ni envoyée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter कैमरे से आपका फॉर्म देखता है। सब कुछ आपके iPhone पर होता है। कोई वीडियो रिकॉर्ड या अपलोड नहीं होता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotterはカメラであなたのフォームを見ます。処理はすべてiPhone上です。動画は録画もアップロードもされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotter observa sua técnica pela câmera. Tudo é processado no seu iPhone. Nenhum vídeo é gravado ou enviado."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter کیمرے سے آپ کا فارم دیکھتا ہے۔ سب کچھ آپ کے iPhone پر ہوتا ہے۔ کوئی ویڈیو ریکارڈ یا اپ لوڈ نہیں ہوتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotter 通过相机看你的动作。一切都在你的 iPhone 上处理。视频不会被录制或上传。"
          }
        }
      }
    },
