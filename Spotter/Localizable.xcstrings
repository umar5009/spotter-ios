            "value" : "Geh tiefer. Oberschenkel parallel zum Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja más. Busca los muslos paralelos al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends plus bas. Vise les cuisses parallèles au sol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "और नीचे जाएँ। जाँघें फ़र्श के समानांतर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もっと深く。太ももを床と平行に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça mais. Busque as coxas paralelas ao chão."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اور نیچے جائیں۔ رانوں کو فرش کے متوازی رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再蹲深一点。大腿尽量与地面平行。"
          }
        }
      }
    },
