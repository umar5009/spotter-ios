    "Turn side-on to the camera. Prop your phone at hip height, about 2 to 3 metres away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف جانبًا للكاميرا. ضع الهاتف عند ارتفاع الورك، على بعد مترين إلى ثلاثة تقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich seitlich zur Kamera. Stell das Telefon auf Hüfthöhe, etwa 2 bis 3 Meter entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de lado a la cámara. Apoya el teléfono a la altura de la cadera, a unos 2 o 3 metros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets-toi de profil. Pose le téléphone à hauteur de hanches, à environ 2 ou 3 mètres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरे की तरफ़ बगल करके खड़े हों। फ़ोन कूल्हे की ऊँचाई पर, लगभग 2 से 3 मीटर दूर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
