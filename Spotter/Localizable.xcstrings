        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो छोटा अंतर आप रख सकते हैं, वह उस परफेक्ट डाइट से बेहतर है जिसे आप गुरुवार छोड़ देते हैं।"
          }
