          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تھوڑا اور جھکیں۔ ہیمسٹرنگ میں کھنچاؤ محسوس کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再屈髋一点。感受腘绳肌的拉伸。"
          }
        }
      }
    },
