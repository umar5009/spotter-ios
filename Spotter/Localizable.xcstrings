    "Don't chase a number that makes the next session worse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تطارد رقمًا يجعل الجلسة التالية أسوأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag keine Zahl, die die nächste Einheit schlechter macht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No persigas un número que empeore la siguiente sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne cours pas après un chiffre qui gâche la séance suivante."
