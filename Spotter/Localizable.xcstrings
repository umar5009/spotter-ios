    },
    "Every session adapts: hit your reps with a form score above 85 and Spotter will suggest progressing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل جلسة تتكيّف: إذا أنهيت التكرارات بدرجة أداء فوق 85 فسيقترح Spotter التقدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Einheit passt sich an: schaffst du die Wiederholungen mit einer Form über 85, schlägt Spotter vor weiterzugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sesión se adapta: si cumples las repeticiones con una técnica por encima de 85, Spotter te propondrá progresar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque séance s’adapte : si tu fais tes répétitions avec une technique au-dessus de 85, Spotter proposera de progresser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सत्र ढलता है: 85 से ऊपर फॉर्म के साथ रेप पूरे करें और Spotter आगे बढ़ने का सुझाव देगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎回のセッションは適応します。フォーム85超で回数をこなすと、Spotterが進むことを提案します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sessão se adapta: se você cumprir as repetições com técnica acima de 85, o Spotter vai sugerir progredir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر سیشن ڈھلتا ہے: 85 سے اوپر فارم کے ساتھ ریپس پورے کریں اور Spotter آگے بڑھنے کی تجویز دے گا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次训练都会调整：次数完成且动作质量超过 85，Spotter 会建议进阶。"
          }
        }
      }
    },
    "Everything runs on your iPhone. No video is recorded or uploaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء يعمل على iPhone. لا يُسجَّل فيديو ولا يُرفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles läuft auf deinem iPhone. Es wird kein Video aufgenommen oder hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo ocurre en tu iPhone. No se graba ni se sube ningún vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se passe sur ton iPhone. Aucune vidéo n’est enregistrée ni envoyée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ आपके iPhone पर चलता है। कोई वीडियो रिकॉर्ड या अपलोड नहीं होता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてはiPhone上で動きます。動画は録画もアップロードもされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo acontece no seu iPhone. Nenhum vídeo é gravado ou enviado."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سب کچھ آپ کے iPhone پر چلتا ہے۔ کوئی ویڈیو ریکارڈ یا اپ لوڈ نہیں ہوتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在你的 iPhone 上完成。视频不会被录制或上传。"
          }
        }
      }
