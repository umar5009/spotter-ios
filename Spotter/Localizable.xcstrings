        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा अंक न पकड़ें जो अगला सत्र खराब कर दे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
