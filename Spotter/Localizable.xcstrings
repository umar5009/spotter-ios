    "Best day in this %lld-day streak, and the most points you've scored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل يوم في سلسلة %lld يومًا، وأعلى نقاط سجلتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bester Tag in dieser %lld-Tage-Serie und die meisten Punkte, die du je hattest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor día de esta racha de %lld días, y la mayor puntuación que has conseguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur jour de cette série de %lld jours, et le plus de points que tu aies marqués."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस %lld-दिन की लय का सर्वश्रेष्ठ दिन, और आपके अब तक के सबसे अधिक अंक।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この %lld 日連続で最高の日で、これまでで一番高い得点です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor dia desta sequência de %lld dias, e a maior pontuação que você já fez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس %lld دن کی لگاتار میں بہترین دن، اور آپ کے اب تک کے سب سے زیادہ پوائنٹس۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这 %lld 天连续里的最佳日，也是你得分最高的一天。"
          }
        }
      }
    },
