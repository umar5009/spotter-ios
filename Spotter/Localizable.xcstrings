    "Move slowly enough to feel the position, then own it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحرّك ببطء يكفي لتشعر بالوضع، ثم امتلكه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweg dich langsam genug, um die Position zu spüren, dann beherrsche sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muévete lo bastante despacio para sentir la posición, y luego contrólala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouge assez lentement pour sentir la position, puis maîtrise-la."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतनी धीमी गति से हिलें कि स्थिति महसूस हो, फिर उसे अपनाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポジションを感じられる速さで動き、それから自分のものにする。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova-se devagar o bastante para sentir a posição e depois dominá-la."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتنی آہستہ ہلیں کہ پوزیشن محسوس ہو، پھر اسے اپنے قابو میں لیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢到能感觉到位置，然后把它稳住。"
          }
        }
      }
    },
