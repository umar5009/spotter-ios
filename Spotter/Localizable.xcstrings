    },
    "Lie on your back, knees bent, feet flat and hip-width apart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استلقِ على ظهرك، والركبتان مثنيتان، والقدمان مسطحتان بعرض الوركين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dich auf den Rücken, Knie gebeugt, Füße hüftbreit flach."
