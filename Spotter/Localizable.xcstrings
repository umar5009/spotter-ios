          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexiona un poco las rodillas y lleva las caderas recto hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
