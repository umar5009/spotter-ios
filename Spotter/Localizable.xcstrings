        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique de lado para a câmera. Apoie o celular na altura do quadril, a uns 2 ou 3 metros."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیمرے کی طرف پہلو کر کے کھڑے ہوں۔ فون کولہے کی اونچائی پر، تقریباً 2 سے 3 میٹر دور رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
