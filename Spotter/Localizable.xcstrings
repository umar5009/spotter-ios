    "Prop up your phone. Spotter counts your reps, scores your form and tells you how to fix it out loud, as you move." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسند هاتفك. يعدّ Spotter تكراراتك ويقيّم أداءك ويقول لك بصوت عالٍ كيف تصلحه وأنت تتحرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell das Telefon hin. Spotter zählt deine Wiederholungen, bewertet deine Form und sagt dir laut, wie du sie korrigierst, während du dich bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya el teléfono. Spotter cuenta tus repeticiones, puntúa tu técnica y te dice en voz alta cómo corregirla mientras te mueves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose le téléphone. Spotter compte tes répétitions, note ta technique et te dit à voix haute comment corriger, pendant que tu bouges."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन टिकाएँ। Spotter आपके रेप गिनता है, फॉर्म आँकता है और हिलते हुए ज़ोर से बताता है कि कैसे सुधारें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマホを立てる。Spotterが回数を数え、フォームを採点し、動きながら直し方を声で伝えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie o celular. O Spotter conta suas repetições, pontua sua técnica e diz em voz alta como corrigir, enquanto você se move."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فون ٹیکائیں۔ Spotter آپ کی ریپس گنتا ہے، فارم جانچتا ہے اور ہلتے ہوئے بلند آواز سے بتاتا ہے کہ کیسے درست کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手机支起来。Spotter 会数次数、给动作打分，并在你移动时大声告诉你怎么改。"
          }
        }
      }
    },
