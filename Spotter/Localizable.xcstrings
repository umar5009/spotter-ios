        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkte sind deine Wiederholungen und Haltezeiten, gewichtet nach der Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos son tus repeticiones y aguantes, ponderados por la técnica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
